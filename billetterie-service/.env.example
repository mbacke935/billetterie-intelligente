PORT=5002
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=billetterie_titres
NODE_ENV=development

# Même secret que le Service Utilisateurs (backend) et le Service Abonnements :
# les 3 services vérifient le même JWT, chacun sans jamais accéder aux bases des autres.
JWT_SECRET=

# Clé de signature HMAC des QR Codes (jeton opaque, non falsifiable sans cette clé).
QR_SECRET=

# URLs des microservices avec lesquels ce service communique exclusivement via API.
USERS_SERVICE_URL=http://localhost:5000
ABONNEMENTS_SERVICE_URL=http://localhost:5001
